# Copy to .env for local runs. On Vercel, set these under Settings → Environment Variables.

# Only this email can sign in to the admin; contact messages are sent here too.
ADMIN_EMAIL=xamidovasadbek.dev@gmail.com
# Recovery code for setting the first password or resetting a forgotten one. Make up a long phrase.
ADMIN_SETUP_CODE=
# GitHub token that can write to the site repo (classic token with the "repo" scope).
GITHUB_TOKEN=
GITHUB_REPO=xamidovasadbekdev-arch/Personal_blog
# Upstash Redis. The Vercel integration adds these automatically. Leave empty locally to use memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Resend API key for the contact form (https://resend.com/api-keys).
RESEND_API_KEY=
# Sender address. After verifying xamidovasadbek.dev in Resend, use e.g. "Portfolio <contact@xamidovasadbek.dev>".
CONTACT_FROM=Portfolio <onboarding@resend.dev>
# Sites allowed to call the API from the browser.
ALLOWED_ORIGINS=https://xamidovasadbek.dev,https://www.xamidovasadbek.dev,http://localhost:5173
